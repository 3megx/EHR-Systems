{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;Database=ehr_notification;User Id=postgres;Password=postgres;"
  },
  "Jwt": {
    "Secret": "your-256-bit-secret-key-change-in-production",
    "Issuer": "ehr-notification-service",
    "Audience": "ehr-api",
    "ExpirationMinutes": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "notification-service-group",
    "Topics": {
      "NotificationEvents": "notification-events",
      "DomainEvents": "domain-events"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/notification-service-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Properties": {
      "Application": "EHRPlatform.Services.Notification"
    }
  }
}
