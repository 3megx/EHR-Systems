{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AuditDb": "Host=localhost;Port=5432;Database=audit_db;Username=ehr_user;Password=SecurePassword123!;",
    "Redis": "localhost:6379"
  },
  "Auth": {
    "Authority": "http://localhost:5000",
    "Audience": "audit-service"
  },
  "Elasticsearch": {
    "Nodes": ["http://localhost:9200"],
    "Username": "elastic",
    "Password": "changeme",
    "DefaultIndex": "audit-logs"
  },
  "Kafka": {
    "BootstrapServers": ["localhost:9092"],
    "GroupId": "audit-service",
    "Topics": ["audit-events", "data-changes"],
    "SecurityProtocol": "PlainText"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/audit-service-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
