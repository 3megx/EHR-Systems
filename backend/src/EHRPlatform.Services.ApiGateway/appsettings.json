{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,password=redis_password"
  },
  "Jwt": {
    "Secret": "your-super-secret-key-change-in-production-at-least-32-characters-long!",
    "Issuer": "ehr-platform",
    "Audience": "ehr-api",
    "ExpirationMinutes": 60
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-routes": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" },
        "Priority": 10,
        "Transforms": [{ "PathRemovePrefix": "/api/v1/auth" }]
      },
      "patient-routes": {
        "ClusterId": "patient-cluster",
        "AuthorizationPolicy": "Bearer",
        "Match": { "Path": "/api/v1/patients/{**catch-all}" },
        "Priority": 10,
        "Transforms": [{ "PathRemovePrefix": "/api/v1/patients" }]
      },
      "clinical-routes": {
        "ClusterId": "clinical-cluster",
        "AuthorizationPolicy": "Bearer",
        "Match": { "Path": "/api/v1/clinical/{**catch-all}" },
        "Priority": 10,
        "Transforms": [{ "PathRemovePrefix": "/api/v1/clinical" }]
      },
      "appointments-routes": {
        "ClusterId": "appointments-cluster",
        "AuthorizationPolicy": "Bearer",
        "Match": { "Path": "/api/v1/appointments/{**catch-all}" },
        "Priority": 10
      },
      "prescription-routes": {
        "ClusterId": "prescription-cluster",
        "AuthorizationPolicy": "Bearer",
        "Match": { "Path": "/api/v1/prescriptions/{**catch-all}" },
        "Priority": 10
      },
      "billing-routes": {
        "ClusterId": "billing-cluster",
        "AuthorizationPolicy": "Bearer",
        "Match": { "Path": "/api/v1/billing/{**catch-all}" },
        "Priority": 10
      },
      "audit-routes": {
        "ClusterId": "audit-cluster",
        "AuthorizationPolicy": "Bearer",
        "Match": { "Path": "/api/v1/audit/{**catch-all}" },
        "Priority": 10
      },
      "analytics-routes": {
        "ClusterId": "analytics-cluster",
        "AuthorizationPolicy": "Bearer",
        "Match": { "Path": "/api/v1/analytics/{**catch-all}" },
        "Priority": 10
      },
      "notification-hubs-routes": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/hubs/{**catch-all}" },
        "Priority": 5
      },
      "notification-api-routes": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "Bearer",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" },
        "Priority": 10
      }
    },
    "Clusters": {
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "identity": { "Address": "http://localhost:5001" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3,
            "Path": "/health"
          }
        }
      },
      "patient-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "patient": { "Address": "http://localhost:5002" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3,
            "Path": "/health"
          }
        }
      },
      "clinical-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "clinical": { "Address": "http://localhost:5003" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3,
            "Path": "/health"
          }
        }
      },
      "appointments-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "appointments": { "Address": "http://localhost:5004" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3,
            "Path": "/health"
          }
        }
      },
      "notification-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "notification": { "Address": "http://localhost:5005" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3,
            "Path": "/health"
          }
        }
      },
      "prescription-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "prescription": { "Address": "http://localhost:5008" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3,
            "Path": "/health"
          }
        }
      },
      "billing-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "billing": { "Address": "http://localhost:5007" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3,
            "Path": "/health"
          }
        }
      },
      "audit-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "audit": { "Address": "http://localhost:5006" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3,
            "Path": "/health"
          }
        }
      },
      "analytics-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "analytics": { "Address": "http://localhost:5009" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3,
            "Path": "/health"
          }
        }
      }
    }
  }
}
