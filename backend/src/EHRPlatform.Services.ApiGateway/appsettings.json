{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,password=redis_password"
  },
  "Jwt": {
    "Secret": "your-super-secret-key-change-in-production-at-least-32-characters-long!",
    "Issuer": "ehr-platform",
    "Audience": "ehr-api",
    "ExpirationMinutes": 60
  },
  "ReverseProxy": {
    "Routes": [
      {
        "RouteId": "auth-routes",
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Priority": 10,
        "Transforms": [
          {
            "PathPattern": "/api/v1/auth/{**catch-all}",
            "PathReplacement": "/{**catch-all}"
          }
        ]
      },
      {
        "RouteId": "patient-routes",
        "ClusterId": "patient-cluster",
        "Match": {
          "Path": "/api/v1/patients/{**catch-all}"
        },
        "AuthorizationPolicy": "Bearer",
        "Priority": 10,
        "Transforms": [
          {
            "PathPattern": "/api/v1/patients/{**catch-all}",
            "PathReplacement": "/{**catch-all}"
          }
        ]
      },
      {
        "RouteId": "clinical-routes",
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/v1/clinical/{**catch-all}"
        },
        "AuthorizationPolicy": "Bearer",
        "Priority": 10,
        "Transforms": [
          {
            "PathPattern": "/api/v1/clinical/{**catch-all}",
            "PathReplacement": "/{**catch-all}"
          }
        ]
      },
      {
        "RouteId": "appointments-routes",
        "ClusterId": "appointments-cluster",
        "Match": {
          "Path": "/api/v1/appointments/{**catch-all}"
        },
        "AuthorizationPolicy": "Bearer",
        "Priority": 10
      }
    ],
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://identity-service:5000"
          }
        },
        "SessionAffinity": {
          "Enabled": false
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient": {
            "Address": "http://patient-service:5000"
          }
        },
        "SessionAffinity": {
          "Enabled": false
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "UnhealthyThreshold": 3
          }
        }
      },
      "clinical-cluster": {
        "Destinations": {
          "clinical": {
            "Address": "http://clinical-service:5000"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30"
          }
        }
      },
      "appointments-cluster": {
        "Destinations": {
          "appointments": {
            "Address": "http://appointments-service:5000"
          }
        }
      }
    }
  }
}
